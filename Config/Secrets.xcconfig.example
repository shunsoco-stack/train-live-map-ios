// Copy this file to Secrets.xcconfig for Release builds.
// Never commit Config/Secrets.xcconfig.
ADMOB_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_BANNER_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

// Optional native APNs device-registration endpoint.
// The current Web backend does not expose this endpoint yet.
APNS_REGISTRATION_URL = https:/$()/example.com/api/apns/devices
